+def _cached_scene_assets_for_restore(path, record, shots):
+    """Rebuild metadata from an exact local coordinator cache; never call a model."""
+    cache = path / 'scene_reference_plan.json'
+    if not cache.is_file():
+        return []
+    from scene_reference_coordinator import validate_plan
+    candidate = {**record, 'shots': shots}
+    mapping = scene_references.scene_mapping(candidate)
+    settings = record['settings']
+    context = {'subtitles': record.get('scenes', []), 'world': settings.get('world', ''),
+               'ratio': settings.get('ratio', '16:9')}
+    story = record.get('creation_parameters', {}).get('story_snapshot')
+    if story is not None:
+        context['story_handoff'] = production_story_handoff(story, record.get('scenes', []))
+    cast = saved_planning_cast(record)
+    if cast:
+        context['project_cast'] = cast
+    source = {'version': 2, 'items': [{'index': i, 'prompt': item['image_prompt'],
+              'visual_design': item.get('visual_design', {})} for i, item in enumerate(mapping)],
+              'source': context, 'style': settings.get('style', ''),
+              'coordination_contract': scene_references.VIDEO_CONTRACT}
+    expected = hashlib.sha256(json.dumps(source, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+    plan = json.loads(cache.read_text(encoding='utf-8'))
+    if plan.get('fingerprint') != expected:
+        raise ValueError('cached scene plan differs from saved design')
+    validate_plan(plan, mapping)
+    assets = []
+    for entry in plan['scenes']:
+        used_by = [shots[index]['id'] for index in entry['members']]
+        fingerprint = hashlib.sha256(json.dumps({
+            'prompt': entry['reference_prompt'], 'members': used_by,
+            'style': settings.get('style', ''), 'world': settings.get('world', ''),
+            'ratio': settings.get('ratio', '16:9')}, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:16]
+        identity = 'scene_ref_' + fingerprint
+        image = path / f'assets/scene_references/{identity}.jpg'
+        if not image.resolve().is_relative_to(path.resolve()):
+            raise ValueError('scene image outside project')
+        from .openai_image_transport import ledger_path
+        receipt = json.loads(ledger_path(image).read_text(encoding='utf-8'))
+        image_hash = hashlib.sha256(image.read_bytes()).hexdigest()
+        if receipt.get('output_sha256') != image_hash:
+            raise ValueError('scene receipt does not match image')
+        prompt = entry['reference_prompt'].strip() + '\n纯场景资产：无人物、人体局部、人影或人形倒影；无字幕、对话气泡及临时特效。'
+        assets.append({'id': identity, 'asset_kind': 'scene_reference', 'image_status': 'completed',
+                       'image': image.relative_to(path).as_posix(),
+                       'image_version': image_hash,
+                       'image_prompt': prompt, 'baseline_image_prompt': prompt,
+                       'scene_id': entry['scene_id'], 'name': entry.get('name') or entry['scene_id'],
+                       'used_by': used_by, 'reason': entry['reason']})
+    return assets
