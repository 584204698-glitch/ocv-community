+def _section_bounds(prompt: str) -> dict[str, tuple[int, int]]:
+    names = "|".join(dict.fromkeys((*_SECTIONS, *_KEYFRAME_SECTIONS)))
+    matches = list(re.finditer(rf"(?im)^[ \t]*({names})[ \t]*:[ \t]*\n?", prompt))
