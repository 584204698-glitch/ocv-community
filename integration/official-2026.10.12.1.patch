+@router.post('/{identity}/shots/{shot_id}/retry-preparation')
+def retry_shot_preparation(identity: str, shot_id: str, data: Review, request: Request):
+    """Explicitly retry failed native preparation, keeping all approved assets.
+
+    No inference or GPU submission here. The ordinary generate route performs
+    the preparation once under a new shot-local cache key, with full validation.
+    """
+    user = require_user(request)
+    with LOCK:
+        path = directory(user['id'], identity)
+        record = read(path)
+        editable(record, data.revision)
+        if str(path) in ACTIVE:
+            raise HTTPException(409, '项目仍在处理，请等待当前操作结束')
+        shot = _find_shot(record, shot_id)
+        if not shot.get('native_dialogue') or shot.get('video_status') != 'failed':
+            raise HTTPException(409, '只有失败的原生对话镜头可以重新准备；已完成素材不会被重置')
+        if shot.get('video_resume_available') or ((shot.get('video_task_id') or shot.get('video_request'))
+                                                 and not shot.get('video_terminal')):
+            raise HTTPException(409, '原任务结果尚未确认，请先继续查询原任务，避免重复生成')
+        if shot.get('native_grounding_force_recheck'):
+            return record
+        shot['native_grounding_retry'] = int(shot.get('native_grounding_retry') or 0) + 1
+        shot['native_grounding_force_recheck'] = True
+        record['revision'] += 1
+        record.setdefault('logs', []).append(f'{shot_id}：用户选择重新分析本镜开场；旧分析保留，图片、台词、声音、时序与其他镜头不变。下一次生成会调用语言模型。')
+        save(path, record)
+        return record
