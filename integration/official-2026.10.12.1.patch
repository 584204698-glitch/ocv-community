+def _record_prompt_failure(path, shot_id, revision, basis, error):
+    """Private diagnostic output, separate from the accepted project record."""
+    from .video_agents import VideoAgentJSONError
+    if not isinstance(error, VideoAgentJSONError) or error.stage != 'repaired_content':
+        return
+    outputs = getattr(error, 'model_outputs', None)
+    if (not isinstance(outputs, dict) or set(outputs) != {'original', 'repaired'}
+            or any(not isinstance(value, str) or len(value) > 100000 for value in outputs.values())):
+        return
+    folder = path / 'diagnostics' / 'prompt-refresh'
+    try:
+        folder.mkdir(parents=True, exist_ok=True, mode=0o700)
+        target = folder / f'{time.time_ns()}-{uuid.uuid4().hex}.json'
+        payload = {'shot_id': shot_id, 'revision': revision, 'basis': basis,
+                   'stage': error.stage, 'line': error.line, 'column': error.column,
+                   'output_sha256': error.output_sha256, 'model_outputs': outputs}
+        with os.fdopen(os.open(target, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600), 'w', encoding='utf-8') as stream:
+            json.dump(payload, stream, ensure_ascii=False, indent=2)
+    except OSError:
+        # Diagnostics must never hide the real failure or prevent edit cleanup.
+        return
