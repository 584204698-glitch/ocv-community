+@router.post('/{identity}/dialogue-route')
+def set_dialogue_route(identity: str, data: NarrationRoute, request: Request):
+    with LOCK:
+        owner=require_user(request)['id']
+        path=directory(owner,identity);record=read(path)
+        editable(record,data.revision)
+        from .one_click import assert_manual_edit
+        assert_manual_edit(record)
+        from .video_dialogue import native_mode,voice_view
+        if not native_mode(record):raise HTTPException(409,'当前普通旁白项目已使用独立配音')
+        params=record.setdefault('creation_parameters',{})
+        selected_engine=data.tts_engine or params.get('dialogue_tts_engine','indextts25')
+        if params.get('dialogue_route','h3_native')==data.route and params.get('dialogue_tts_engine','indextts25')==selected_engine:return record
+        if data.route=='external_tts':
+            vocal={t['character_id'] for s in record.get('shots',[]) for t in (s.get('native_dialogue') or {}).get('turns',[])}
+            rows={r['character_id']:r for r in voice_view(owner,record)['characters']}
+            if any(identity not in rows or rows[identity]['status']!='current' or
+                   rows[identity].get('voice_mode')=='generated' for identity in vocal):
+                raise HTTPException(409,'请先为每位发言者采用固定音色，精确对白不能使用H3自行生成声音')
+            if selected_engine=='qwen3':
+                from .qwen3_local import health, resolve_saved_voice
+                if not health()['ready']:raise HTTPException(409,'请先安装 Qwen3-TTS Base 克隆模型与运行环境')
+                try:
+                    for identity in vocal:resolve_saved_voice(rows[identity]['voice_id'],owner)
