+def scene_reference_review_error(path, record, *, shot_id=None):
+    if not scene_references.enabled(record):
+        return ''
+    if shot_id is None and record.get('scene_references_status') != 'completed':
+        return '该任务启用了场景参考，请先完成场景参考准备并检查关联镜头'
+    shots = [shot for shot in record.get('shots', []) if shot_id is None or shot['id'] == shot_id]
+    for asset in record.get('scene_assets', []):
+        if not any(shot.get('scene_reference_id') == asset['id'] and shot.get('scene_reference_used_version')
+                   for shot in shots):
+            continue
+        if asset.get('image_status') != 'completed' or (asset.get('image_task') or {}).get('status') == 'running':
+            return '关联场景图片尚未就绪，请完成后再确认'
+        try:
+            actual = hashlib.sha256(_storyboard_image_path(path, asset).read_bytes()).hexdigest()
+        except (OSError, HTTPException):
+            return '关联场景图片缺失，请修复场景并检查核心图后再确认'
+        if actual != asset.get('image_version'):
+            return '关联场景图片与保存版本不一致，请修复场景并检查核心图后再确认'
+    stale = [str(i + 1) for i, shot in enumerate(record['shots'])
+             if (shot_id is None or shot['id'] == shot_id) and _stale_scene_reference(record, shot)]
+    if stale:
+        return '第 ' + '、'.join(stale) + ' 镜仍使用旧版场景，请重绘并检查这些核心图后再确认'
