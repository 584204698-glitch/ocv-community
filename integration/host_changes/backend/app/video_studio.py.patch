+    if any((s.get('image_task') or {}).get('status') == 'running' for s in record.get('shots', [])):
+        raise HTTPException(409, '已有图片编辑尚未确认结束，请先查询原任务')
+    for receipt in (path / 'assets').rglob('*.openai-image.json'):
+        if json.loads(receipt.read_text(encoding='utf-8')).get('status') in {'dispatching', 'unknown'}:
+            raise HTTPException(409, '存在尚未确认结束的图片请求，请先查询原任务；未提交新的检查或修复')
