+                    or any(scenes.get(source.get('slide_id')) != source for source in sources)):
+                raise HTTPException(409, '故事内容或时间轴已变化，不能恢复旧图')
+            try:
+                validate_cast_shot(record, shot)
+                image = _storyboard_image_path(path, shot).resolve()
+                if not image.is_relative_to(path.resolve()) or hashlib.sha256(image.read_bytes()).hexdigest() != shot.get('image_version'):
+                    raise ValueError('image mismatch')
+                version = shot.get('scene_reference_used_version')
+                if version:
+                    candidates = [asset for asset in record.get('scene_asset_archive', []) + record.get('scene_assets', [])
+                                  if asset.get('image_version') == version
+                                  and asset.get('id') == shot.get('scene_reference_id')]
+                    if not candidates:
+                        if cached_assets is None:
+                            cached_assets = _cached_scene_assets_for_restore(path, record, shots)
+                        candidates = [asset for asset in cached_assets if asset['image_version'] == version
+                                      and asset['id'] == shot.get('scene_reference_id')
+                                      and shot['id'] in asset['used_by']]
+                    if not candidates:
+                        raise ValueError('scene missing')
+                    asset = candidates[0]
+                    scene_image = _storyboard_image_path(path, asset).resolve()
+                    if (not scene_image.is_relative_to(path.resolve())
+                            or hashlib.sha256(scene_image.read_bytes()).hexdigest() != version):
+                        raise ValueError('scene mismatch')
+                    if asset['id'] in restored_scenes and restored_scenes[asset['id']]['image_version'] != version:
+                        raise ValueError('conflicting scene versions')
+                    restored_scenes[asset['id']] = copy.deepcopy(asset)
+            except (OSError, ValueError, HTTPException):
+                raise HTTPException(409, '归档图片、场景或角色身份未通过校验，不能恢复') from None
+        record.update(shots=shots, scene_assets=list(restored_scenes.values()), status='image_review',
+                      revision=record['revision'] + 1, error='')
+        if restored_scenes:
+            record['scene_references_status'] = 'completed'
+        record.pop('scene_reference_plan', None)
+        record.pop('export', None)
+        record['logs'].append('已恢复通过校验的归档分镜图片，请检查画面后继续。')
+        save(path, record)
+        return record
