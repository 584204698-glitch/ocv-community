+                != normalize_text_mode(parameters.get('dynamic_text_mode', settings.get('dynamic_text_mode')))):
+            raise HTTPException(409, '分镜规划配置已变化，不能恢复旧图')
+        scenes = {scene['slide_id']: scene for scene in record.get('scenes', [])}
