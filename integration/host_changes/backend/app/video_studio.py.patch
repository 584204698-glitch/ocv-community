+def _retain_unchanged_native_images(path, record, planned):
+    """Reuse completed pixels only when the full compiled design still matches.
+
+    This does not approve image quality or reuse videos. Derived request
+    suffixes and adopted voices are not changes to the core-image design.
+    """
+    previous = {shot['id']: shot for shot in record.get('shots', [])}
+    image_fields = ('image', 'image_status', 'image_version', 'image_error',
+        'image_prompt', 'image_material_numbers_bound',
+        'image_applied_prompt', 'image_prompt_out_of_sync', 'image_origin',
+        'image_history', 'image_output_round', 'image_attempt_output',
+        'native_image_repairs', 'scene_reference_id', 'scene_reference_used_version', 'core_reference_used')
+    for shot in planned:
+        old = previous.get(shot['id'])
+        if old and not old.get('image') and old.get('image_status') in (None, '', 'pending'):
+            from .openai_image_transport import ledger_path
+            output = storyboard_output(path, record, old)
+            # An unused reservation is not a submitted request. Any task,
+            # receipt or output keeps recovery on its original request path.
+            if not (old.get('image_task') or old.get('image_error') or old.get('image_attempt_output')
+                    or output.exists() or ledger_path(output).exists()):
+                for entry in reversed(record.get('edit_history', [])):
+                    candidate = next((row for row in entry.get('shots', [])
+                                      if row.get('id') == shot['id']), None)
+                    if not candidate or candidate.get('image_status') != 'completed':
+                        continue
+                    try:
+                        if _same_native_image_design(path, record, candidate, shot):
+                            old = candidate
+                            break
+                    except (ValueError, OSError, HTTPException):
+                        continue
+        if (not old or old.get('image_status') != 'completed'
+                or old.get('image_prompt_out_of_sync') or old.get('design_needs_review')
+                or (old.get('image_task') or {}).get('status') in {'running', 'failed'}):
+            continue
+        try:
+            from .video_core_references import dependency_error
+            if dependency_error(path, record, old):
+                continue
+            if not _same_native_image_design(path, record, old, shot):
+                continue
+            file = _storyboard_image_path(path, old).resolve()
+            if path.resolve() not in file.parents or not file.is_file():
+                continue
+            if hashlib.sha256(file.read_bytes()).hexdigest() != old.get('image_version'):
+                continue
+        except (ValueError, OSError, HTTPException):
+            continue
+        for key in image_fields:
+            if key in old:
+                shot[key] = copy.deepcopy(old[key])
