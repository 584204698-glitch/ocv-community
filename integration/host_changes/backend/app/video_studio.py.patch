+@router.post('/{identity}/auto-characters')
+def recover_auto_characters(identity: str, data: Review, request: Request):
+    """Repair pre-feature projects without recreating audio or subtitle groups."""
+    owner = int(require_user(request)['id'])
+    with LOCK:
+        path = directory(owner, identity)
+        record = read(path)
+        editable(record, data.revision)
+        if ACTIVE or project_has_image_edits(identity):
+            raise HTTPException(409, '请等待正在进行的任务结束后补齐角色')
+        if record['status'] not in {'draft','storyboard_review','generation_ready','image_review','video_generation_ready','video_review'}:
+            raise HTTPException(409, '当前阶段不能补齐角色，请先停止制作')
+        if (record.get('project_cast') or {}).get('characters') or record.get('references'):
+            raise HTTPException(409, '项目已有角色或参考素材，请在项目角色中核对绑定，不会自动替换已有身份')
+        # Archive the whole previous state, including original image paths;
+        # new images use a new output round, never overwrite old paid results.
+        history = path / 'revision_history' / f'before_auto_characters_{record["revision"]}_{time.time_ns()}.json'
+        history.parent.mkdir(parents=True,exist_ok=True)
+        history.write_text(json.dumps(record,ensure_ascii=False),encoding='utf-8')
+        record.setdefault('creation_parameters',{}).update(auto_character_design=True,dynamic_auto_advance=False)
+        record['image_generation_round']=uuid.uuid4().hex[:12]
+        for shot in record['shots']:
+            shot['design_needs_review']=True
+        if record['shots']:
+            lock_manual_groups(record)
+        for field in ('context','scene_assets','scene_reference_plan','scene_references_status','export'):
+            record.pop(field,None)
+        discard_planning_resume(record)
+        record.update(status='draft',revision=record['revision']+1,error='')
+        record['logs'].append('补齐角色：已保存原分镜和图片历史，保留配音、字幕和镜头时间轴。')
+        save(path,record)
+        return plan(identity,request)
