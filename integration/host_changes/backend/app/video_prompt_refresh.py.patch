+    if opening_issues:
+        raise ValueError('同步前请先核对原阶段方案：' + '；'.join(opening_issues))
+    payload = {'story_context': copy.deepcopy(context), 'shot': prepared[0],
+               'existing_action': action.strip(), 'core_basis': core_basis,
+               'basis_kind': 'image_prompt', 'refresh_basis': 'video_inputs',
+               'reference_catalog': copy.deepcopy(references), 'video_inputs': copy.deepcopy(video_inputs)}
