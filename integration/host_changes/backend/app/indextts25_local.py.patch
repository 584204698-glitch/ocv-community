+def _python_path(value: str) -> Path:
+    """Preserve the venv launcher, including a Linux symlink to base Python.
+
+    Resolving that final symlink before Popen loses the environment's
+    pyvenv.cfg and can run the base interpreter without the TTS dependencies.
+    The portable Windows interpreter remains the default when unset.
+    """
+    path = Path(value.strip()) if value.strip() else PROJECT_ROOT / "runtime" / "python" / "python.exe"
+    if not path.is_absolute():
+        path = PROJECT_ROOT / path
+    return path.absolute()
 
 
