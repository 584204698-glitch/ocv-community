+def _guard_accepts_sigterm(process) -> bool:
+    """Only the PID retained by this Popen may be signalled after arming.
+
+    The installed guard starts its child before registering its handlers.
+    Sending SIGTERM in that window would kill the supervisor alone. Missing
+    /proc evidence is a reason to keep draining/waiting, never to guess.
+    """
+    if sys.platform != "linux" or type(process.pid) is not int or process.pid < 1:
+        return False
+    try:
+        status = Path(f"/proc/{process.pid}/status").read_text(encoding="ascii")
+        caught = next(line.split(":", 1)[1].strip() for line in status.splitlines()
+                      if line.startswith("SigCgt:"))
+        return bool(int(caught, 16) & (1 << (signal.SIGTERM - 1)))
+    except (OSError, ValueError, StopIteration):
+        return False
+
+
+def _wait_for_guard_release(process) -> None:
+    """Drain the owned guard until exit; request stop only once it is armed."""
+    signalled = False
+    while True:
+        try:
+            if process.poll() is not None:
+                return
+            if not signalled and _guard_accepts_sigterm(process):
+                # Popen.send_signal checks this child's state before sending.
+                # Never target its whole group or any PID from shared state.
+                process.terminate()
+                signalled = True
+            process.communicate(timeout=0.2)
+            return
+        except subprocess.TimeoutExpired:
+            continue
+        except ProcessLookupError:
+            continue
+        except KeyboardInterrupt:
+            # The normal signal handler defers repeated SIGINT for the entire
+            # lifecycle. Also contain interrupts injected by callers/tests.
+            continue
+
+
+def _run_guarded_and_stream(command: list[str], *, cwd: Path, env: dict[str, str],
+                            on_line: Callable[[str], None]) -> int:
+    if sys.platform != "linux" or threading.current_thread() is not threading.main_thread():
+        raise RuntimeError("共享 TTS guard 必须由 Linux 主线程监督执行")
+    process = None
+    interrupted = False
+    previous_handler = None
+    handler_installed = False
+    decoder = codecs.getincrementaldecoder("utf-8")("replace")
+    output_offset = 0
+    pending_line = ""
+
+    def defer_interrupt(_signum, _frame):
+        nonlocal interrupted
+        # A callable handler is reset by POSIX exec; unlike SIG_IGN or a
+        # blocked signal mask, it does not make the child ignore SIGINT.
+        interrupted = True
+
+    def consume_snapshot(output: bytes | None, *, final: bool = False) -> None:
+        nonlocal output_offset, pending_line
+        snapshot = output or b""
+        pending_line += decoder.decode(snapshot[output_offset:], final=final)
+        output_offset = len(snapshot)
+        lines = re.split(r"[\r\n]+", pending_line)
+        pending_line = "" if final else lines.pop()
+        for line in lines:
+            on_line(line)
+
+    try:
+        # Install before constructing Popen and keep it until release. Signals
+        # cannot interrupt the assignment and lose the new child's handle, or
+        # escape from the first bytecode of the cleanup block.
+        previous_handler = signal.signal(signal.SIGINT, defer_interrupt)
+        handler_installed = True
+        process = subprocess.Popen(command, cwd=str(cwd), env=env,
+                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                   start_new_session=True)
+        while True:
+            if interrupted:
+                raise KeyboardInterrupt()
+            try:
+                output, _ = process.communicate(timeout=0.2)
+                consume_snapshot(output, final=True)
+                if interrupted:
+                    raise KeyboardInterrupt()
+                return process.returncode
+            except subprocess.TimeoutExpired as exc:
+                consume_snapshot(exc.output)
+    finally:
+        try:
+            if process is not None:
+                _wait_for_guard_release(process)
+        finally:
+            if handler_installed:
+                signal.signal(signal.SIGINT, previous_handler)
+
